{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "qualms",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-27",
	"compatibility_flags": ["nodejs_compat"],
	"build": {
		"command": "npm run build"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	// Replace `id` with the value from:
	// wrangler hyperdrive create qualms-db --connection-string="postgresql://user:pass@your-rds-host.rds.amazonaws.com:5432/dbname"
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "<your-hyperdrive-config-id>",
			"localConnectionString": "postgresql://user:password@localhost:5432/qualms"
		}
	],
	"routes": [
		{
			"pattern": "app.qualms.sh",
			"custom_domain": true
		}
	]
}
