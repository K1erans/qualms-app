{
  "name": "qualms",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "deploy": "npm run deploy -w web",
    "lint": "oxlint && turbo run lint",
