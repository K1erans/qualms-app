{
  "name": "qualms",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "deploy": "npm run deploy -w web",
    "lint": "oxlint && turbo run lint",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "test": "turbo run test",
    "preview": "npm run build -w web && npm run preview -w web",
    "db:up": "brew services start postgresql@18",
    "db:down": "brew services stop postgresql@18",
    "db:schema": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs studio",
    "db:reset": "dropdb --if-exists qualms_dev && createdb -O qualms qualms_dev && npm run db:schema"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.16.0"
    }
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.79.0",
    "@types/node": "^26.2.0",
    "oxlint": "^1.79.0",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "daisyui": "^5.7.22",
    "tailwindcss": "^4.3.3"
  }
}
